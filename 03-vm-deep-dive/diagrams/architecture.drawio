        <mxCell id="e-nic-vm" value="attached" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2DD4E8;strokeWidth=2;fontColor=#8FA3C0;labelBackgroundColor=#0D1E3A;fontFamily=Segoe UI;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nic" target="vm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-nsg-nic" value="guards" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2DD4E8;strokeWidth=2;fontColor=#8FA3C0;labelBackgroundColor=#0D1E3A;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="nsg" target="nic">
          <mxGeometry relative="1" as="geometry">
