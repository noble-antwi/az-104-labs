        <mxCell id="e-pip-nic" value="translated to 10.30.0.4" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2BD99F;strokeWidth=2;fontColor=#2BD99F;labelBackgroundColor=#0A1730;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pip" target="nic">
