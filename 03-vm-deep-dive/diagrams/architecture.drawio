<mxfile host="app.diagrams.net">
  <diagram name="Lab 03 architecture" id="lab03-architecture">
    <mxGraphModel dx="1420" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="900" background="#060D1F" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;font style=&quot;font-size:24px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Lab 03 · VM deep dive&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;One VM is seven resources. Two of them bill while the VM is deallocated.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="30" y="22" width="900" height="60" as="geometry" />
        </mxCell>

        <!-- Subscription -->
        <mxCell id="sub" value="Azure subscription" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#2DD4E8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=12;fontSize=14;fontStyle=1;fontColor=#2DD4E8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="1020" height="770" as="geometry" />
        </mxCell>
        <mxCell id="sub-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1">
          <mxGeometry x="44" y="110" width="28" height="28" as="geometry" />
        </mxCell>

        <!-- Resource group -->
        <mxCell id="rg" value="rg-lab-vm · East US&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px;color:#8FA3C0&quot;&gt;environment=lab · purpose=lab · lab=vm-deep-dive · autoDelete=true · costCenter by policy&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="58" y="150" width="966" height="696" as="geometry" />
        </mxCell>
        <mxCell id="rg-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1">
          <mxGeometry x="72" y="160" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- VNet -->
        <mxCell id="vnet" value="vnet-lab-vm · 10.30.0.0/16" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5B9BFF;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=46;spacingTop=10;fontSize=13;fontStyle=1;fontColor=#5B9BFF;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="86" y="222" width="600" height="600" as="geometry" />
        </mxCell>
        <mxCell id="vnet-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1">
          <mxGeometry x="98" y="231" width="32" height="19" as="geometry" />
        </mxCell>

        <!-- Subnet -->
        <mxCell id="snet" value="snet-eastus-1 · 10.30.0.0/24&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px;color:#8FA3C0&quot;&gt;.0 to .3 and .255 reserved by Azure, so the first VM gets .4&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=#0D1E3A;strokeColor=#5B9BFF;strokeWidth=1;verticalAlign=top;align=right;spacingRight=16;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="110" y="272" width="552" height="530" as="geometry" />
        </mxCell>

        <!-- NIC -->
        <mxCell id="nic" value="&lt;b&gt;NIC vm-lab-01791&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;private IP 10.30.0.4&lt;br&gt;kept on deallocate&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;● free&lt;/font&gt;" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/networking/Network_Interfaces.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="180" y="360" width="68" height="60" as="geometry" />
        </mxCell>

        <!-- VM -->
        <mxCell id="vm" value="&lt;b&gt;vm-lab-01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Ubuntu 24.04 · Standard_D2s_v3&lt;br&gt;2 vCPU · 8 GiB · Trusted Launch&lt;br&gt;SSH key only (ed25519), password off&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFC04D&quot;&gt;● compute bills until deallocated&lt;/font&gt;" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/compute/Virtual_Machine.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="462" y="358" width="69" height="64" as="geometry" />
        </mxCell>

        <!-- Temp disk -->
        <mxCell id="tmp" value="&lt;b&gt;Temporary disk · 16 GiB · /mnt&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;on the physical host, part of the size&lt;br&gt;not a resource of its own&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;● wiped on deallocate&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;dashed=1;fillColor=#1A1440;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E6EEF8;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="396" y="560" width="200" height="86" as="geometry" />
        </mxCell>

        <!-- NSG -->
        <mxCell id="nsg" value="&lt;b&gt;vm-lab-01-nsg&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;100 · allow TCP 22 from one IP&lt;br&gt;65500 · DenyAllInBound&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;● free&lt;/font&gt;" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/networking/Network_Security_Groups.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="188" y="580" width="52" height="64" as="geometry" />
        </mxCell>

        <!-- Public IP -->
        <mxCell id="pip" value="&lt;b&gt;vm-lab-01-ip&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Standard · static&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFC04D&quot;&gt;● bills while deallocated&lt;/font&gt;" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/networking/Public_IP_Addresses.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="826" y="250" width="65" height="52" as="geometry" />
        </mxCell>

        <!-- OS disk -->
        <mxCell id="osd" value="&lt;b&gt;OS disk · 30 GiB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Standard HDD (portal) · SSD (Bicep)&lt;br&gt;stored apart from the host&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;● survives deallocate&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFC04D&quot;&gt;● bills while deallocated&lt;/font&gt;" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/compute/Disks.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="828" y="420" width="57" height="56" as="geometry" />
        </mxCell>

        <!-- Auto-shutdown -->
        <mxCell id="sch" value="&lt;b&gt;shutdown-computevm-vm-lab-01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Microsoft.DevTestLab/schedules&lt;br&gt;hidden type · daily 01:00&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;● free&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0D1E3A;strokeColor=#FFC04D;strokeWidth=1.5;fontSize=11;fontColor=#E6EEF8;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="752" y="640" width="236" height="90" as="geometry" />
        </mxCell>

        <!-- Outside: admin laptop -->
        <mxCell id="laptop" value="&lt;b&gt;Admin laptop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;one home IP · private key stays here&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#2BD99F;strokeWidth=1.5;fontSize=12;fontColor=#E6EEF8;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1100" y="240" width="270" height="70" as="geometry" />
        </mxCell>

        <!-- Outside: portal -->
        <mxCell id="portal" value="&lt;b&gt;Azure portal · Run Command&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;through the VM agent, as root&lt;br&gt;no inbound port needed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=12;fontColor=#E6EEF8;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1100" y="370" width="270" height="76" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;━━&lt;/font&gt; SSH path&lt;br&gt;&lt;font color=&quot;#2DD4E8&quot;&gt;━━&lt;/font&gt; attached to&lt;br&gt;&lt;font color=&quot;#A78BFA&quot;&gt;┅┅&lt;/font&gt; management, no port&lt;br&gt;&lt;font color=&quot;#FFC04D&quot;&gt;┅┅&lt;/font&gt; automation&lt;br&gt;&lt;br&gt;&lt;b&gt;While deallocated&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FFC04D&quot;&gt;●&lt;/font&gt; still bills: OS disk, public IP&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;●&lt;/font&gt; free: VM compute, NIC, NSG, VNet, schedule" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;fontSize=12;fontColor=#E6EEF8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1100" y="560" width="290" height="190" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-ssh" value="SSH · TCP 22 · key" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2BD99F;strokeWidth=2;fontColor=#2BD99F;labelBackgroundColor=#060D1F;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="laptop" target="pip">
