          </mxGeometry>
        </mxCell>
        
        <mxCell id="e-osd-vm" value="boots from" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2DD4E8;strokeWidth=2;fontColor=#8FA3C0;labelBackgroundColor=#0A1730;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="osd" target="vm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sch-vm" value="deallocate 01:00" style="endArrow=block;endFill=1;dashed=1;html=1;fontSize=11;strokeColor=#FFC04D;strokeWidth=2;fontColor=#FFC04D;labelBackgroundColor=#0A1730;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sch" target="vm">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="640" y="685" /><mxPoint x="640" y="390" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-portal-vm" value="Run Command" style="endArrow=block;endFill=1;dashed=1;html=1;fontSize=11;strokeColor=#A78BFA;strokeWidth=2;fontColor=#A78BFA;labelBackgroundColor=#0A1730;fontFamily=Segoe UI;exitX=0;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="portal" target="vm">
