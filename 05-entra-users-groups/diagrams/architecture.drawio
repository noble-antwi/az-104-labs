        <mxCell id="guests" value="&lt;b&gt;2 B2B guests&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Guest One (Partner Auditor)&lt;br&gt;Guest Two (Vendor Engineer)&lt;/font&gt;&lt;br&gt;&lt;br&gt;UPN: email, @ changed to _, then &lt;font color=&quot;#FFC04D&quot;&gt;#EXT#&lt;/font&gt;@...onmicrosoft.com&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;invite email off · PendingAcceptance&lt;br&gt;password stays in their home tenant&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;in no group: no Azure access&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="370" height="175" as="geometry" /></mxCell>
        <mxCell id="allstaff" value="&lt;b&gt;L5-All-Staff&lt;/b&gt; · security · assigned · nested&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;direct members: 2 groups · all members: 8 (6 people + 2 groups)&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#2DD4E8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="770" height="240" as="geometry" /></mxCell>
