        <mxCell id="users" value="&lt;b&gt;6 member users&lt;/b&gt; (l5-*)&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;created by scripts/bulk-create-users.ps1&lt;br&gt;(Microsoft Graph POST /users, one per CSV row)&lt;br&gt;the portal bulk job failed 3 times&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;all disabled&lt;/font&gt; · usage location US&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;department set: Branch Operations or Treasury&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="370" height="175" as="geometry" /></mxCell>
