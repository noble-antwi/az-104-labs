<mxfile host="app.diagrams.net">
  <diagram name="Lab 05 architecture" id="lab05-architecture">
    <mxGraphModel dx="1420" dy="880" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="790" background="#060D1F" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:24px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Lab 05 · Entra ID users and groups&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Users and guests in Entra, teams nested in one group, one Azure role given to that group&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1100" height="60" as="geometry" /></mxCell>
        <mxCell id="tenant" value="Microsoft Entra ID · biira.online" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#A78BFA;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=12;fontSize=14;fontStyle=1;fontColor=#A78BFA;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="830" height="650" as="geometry" /></mxCell>
