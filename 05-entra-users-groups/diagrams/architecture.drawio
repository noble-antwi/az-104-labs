        <mxCell id="reader" value="&lt;b&gt;&lt;font color=&quot;#2BD99F&quot;&gt;Reader&lt;/font&gt;&lt;/b&gt; (built-in)&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;assigned to: L5-All-Staff (group)&lt;/font&gt;&lt;br&gt;&lt;br&gt;Check access on Kofi Boateng:&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;Reader on rg-lab-vm&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;assigned to L5-All-Staff&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Kofi → Branch-Operations → All-Staff&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#2BD99F;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="955" y="240" width="380" height="165" as="geometry" /></mxCell>
