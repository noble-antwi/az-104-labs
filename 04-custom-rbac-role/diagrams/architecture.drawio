        </mxCell>
        <mxCell id="mi" value="&lt;b&gt;vm-lab-01 identity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;system-assigned · no secret to store&lt;br&gt;born and deleted with the VM&lt;/font&gt;" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/identity/Managed_Identities.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
