        <mxCell id="vm" value="&lt;b&gt;vm-lab-01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;from lab 03 · Ubuntu 24.04&lt;br&gt;extension: AADSSHLoginForLinux&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;✓ start (allowed)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;✗ delete (403)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;✗ see NIC / IPs (not in role)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;✓ Entra SSH (after User Login)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;✗ sudo&lt;/font&gt;" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/compute/Virtual_Machine.svg;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;fontSize=11;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1090" y="500" width="69" height="64" as="geometry" />
        </mxCell>

