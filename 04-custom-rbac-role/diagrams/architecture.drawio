        <mxCell id="assign" value="&lt;b&gt;Role assignments for lab-vmop&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2DD4E8&quot;&gt;Lab VM Operator&lt;/font&gt; · management plane&lt;br&gt;&lt;font color=&quot;#2DD4E8&quot;&gt;Lab VM Operator (IaC)&lt;/font&gt; · management plane&lt;br&gt;&lt;font color=&quot;#A78BFA&quot;&gt;Virtual Machine User Login&lt;/font&gt; · data plane&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;the user's only roles anywhere in the tenant&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0D1E3A;strokeColor=#2BD99F;strokeWidth=1.5;fontSize=12;fontColor=#E6EEF8;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Segoe UI;" vertex="1" parent="1">
