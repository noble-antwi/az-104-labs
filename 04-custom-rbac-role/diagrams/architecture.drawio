          <mxGeometry x="434" y="120" width="28" height="28" as="geometry" />
        </mxCell>

        <!-- Role definitions -->
        <mxCell id="custom" value="&lt;b&gt;Custom role definitions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;assignable scope: the subscription&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2DD4E8&quot;&gt;Lab VM Operator&lt;/font&gt; (portal)&lt;br&gt;&lt;font color=&quot;#2DD4E8&quot;&gt;Lab VM Operator (IaC)&lt;/font&gt; (Bicep)&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;✓ virtualMachines/read&lt;br&gt;✓ start · deallocate · restart · powerOff&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;✗ write · delete · no wildcard&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#2DD4E8;strokeWidth=1.5;fontSize=12;fontColor=#E6EEF8;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="450" y="165" width="420" height="215" as="geometry" />
        </mxCell>
        <mxCell id="builtin" value="&lt;b&gt;Built-in roles used&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#A78BFA&quot;&gt;Virtual Machine User Login&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;one data action: login/action (shell, no sudo)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Read for comparison, not assigned:&lt;br&gt;Virtual Machine Contributor (virtualMachines/*)&lt;br&gt;Virtual Machine Administrator Login (sudo)&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=12;fontColor=#E6EEF8;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="910" y="165" width="450" height="215" as="geometry" />
        </mxCell>

        <!-- Resource group -->
        <mxCell id="rg" value="rg-lab-vm · East US&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px;color:#8FA3C0&quot;&gt;everything inside inherits these roles&lt;/span&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1">
