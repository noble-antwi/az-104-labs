<mxfile host="app.diagrams.net">
  <diagram name="Lab 06 architecture" id="lab06-architecture">
    <mxGraphModel dx="1420" dy="780" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="780" background="#060D1F" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;font style=&quot;font-size:24px&quot; color=&quot;#FFFFFF&quot;&gt;&lt;b&gt;Lab 06 · Azure Files share&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;One SMB share reached three ways: blocked from home, HTTPS from the portal with Entra roles, SMB from a VM until keys were switched off&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1300" height="60" as="geometry" /></mxCell>
        <mxCell id="outside" value="Outside Azure" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#8FA3C0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=12;fontSize=14;fontStyle=1;fontColor=#8FA3C0;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="330" height="640" as="geometry" /></mxCell>
        <mxCell id="laptop" value="&lt;b&gt;Your laptop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;home network&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;outbound 445 blocked&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Test-NetConnection :445 = False&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#FF6B5E;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="55" y="165" width="280" height="150" as="geometry" /></mxCell>
        <mxCell id="portal" value="&lt;b&gt;Azure portal (you)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;HTTPS 443&lt;/font&gt;&lt;br&gt;&lt;br&gt;Owner on the subscription&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;management plane only&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;+ Storage File Data Privileged Reader&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;on stlabfilesnoble01: list and download, no write&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#A78BFA;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="55" y="345" width="280" height="230" as="geometry" /></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;red: blocked or denied&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;green: Entra role over HTTPS&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FFC04D&quot;&gt;amber: storage key over SMB&lt;/font&gt;&lt;br&gt;dashed: until keys were turned off" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;fontSize=12;fontColor=#E6EEF8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="55" y="600" width="280" height="130" as="geometry" /></mxCell>
        <mxCell id="sub" value="Azure subscription · East US" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#2DD4E8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=52;spacingTop=12;fontSize=14;fontStyle=1;fontColor=#2DD4E8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="990" height="640" as="geometry" /></mxCell>
        <mxCell id="sub-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/general/Subscriptions.svg;" vertex="1" parent="1"><mxGeometry x="414" y="120" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="rg" value="rg-lab-files&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px;color:#8FA3C0&quot;&gt;base from Bicep (main.bicep, vm.bicep), share and settings by hand · deleted 21 Nov 2026&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430" y="165" width="930" height="400" as="geometry" /></mxCell>
        <mxCell id="rg-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1"><mxGeometry x="444" y="175" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="vnet" value="&lt;b&gt;vnet-lab-files&lt;/b&gt; 10.60.0.0/16&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;snet-clients 10.60.0.0/24&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#2DD4E8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=48;spacingTop=8;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="455" y="230" width="330" height="310" as="geometry" /></mxCell>
        <mxCell id="vnet-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/networking/Virtual_Networks.svg;" vertex="1" parent="1"><mxGeometry x="465" y="238" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="vm" value="&lt;b&gt;vm-files-01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;Standard_B2ats_v2 · Ubuntu 24.04&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;cloud-init: cifs-utils&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;NSG: SSH from my IP only&lt;/font&gt;&lt;br&gt;&lt;br&gt;mount -t cifs → /media/branch-docs&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;user = account name, password = key&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#FF6B5E&quot;&gt;keys off: Host is down, error(13)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#2DD4E8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="280" height="200" as="geometry" /></mxCell>
        <mxCell id="sa" value="&lt;b&gt;stlabfilesnoble01&lt;/b&gt; · StorageV2 · LRS · TLS 1.2&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;shared key access: ON → &lt;font color=&quot;#FF6B5E&quot;&gt;OFF&lt;/font&gt; · Entra default in portal: ON&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;key1 rotated after it was exposed&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#2DD4E8&quot;&gt;branch-docs&lt;/font&gt;&lt;/b&gt; · Transaction optimized · soft delete 7 days&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;7 files incl. from-linux.txt (written over SMB)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Snapshot&lt;/b&gt; 2026-11-20T04:30Z&lt;br&gt;&lt;font color=&quot;#8FA3C0&quot;&gt;policy.txt = Version 1 · restored over Version 2&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#2DD4E8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=13;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="515" height="310" as="geometry" /></mxCell>
        <mxCell id="sa-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/storage/Storage_Accounts.svg;" vertex="1" parent="1"><mxGeometry x="1290" y="240" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="rgiac" value="rg-lab-files-iac&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px;color:#8FA3C0&quot;&gt;files-iac.bicep: the end state in one deployment · deleted 21 Nov 2026&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#E6EEF8&quot;&gt;stlabfilesnoble02&lt;/font&gt;&lt;/b&gt;: born with shared key access OFF and Entra as the portal default · branch-docs · Privileged Reader → you&lt;br&gt;&lt;font color=&quot;#2BD99F&quot;&gt;opened straight into &quot;Microsoft Entra user account&quot;, no key needed&lt;/font&gt;&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#0A1730;strokeColor=#1F3A66;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=52;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#E6EEF8;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430" y="590" width="930" height="135" as="geometry" /></mxCell>
        <mxCell id="rgiac-icon" value="" style="image;aspect=fixed;labelBackgroundColor=none;html=1;points=[];image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1"><mxGeometry x="444" y="600" width="30" height="30" as="geometry" /></mxCell>
        <mxCell id="e-home" value="SMB 445: blocked" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#FF6B5E;strokeWidth=2;fontColor=#FF6B5E;labelBackgroundColor=#060D1F;fontFamily=Segoe UI;dashed=1;exitX=1;exitY=0.3;entryX=0.3;entryY=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="laptop" target="sa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="210" /><mxPoint x="380" y="98" /><mxPoint x="975" y="98" /></Array></mxGeometry></mxCell>
        <mxCell id="e-portal" value="HTTPS 443 · Entra + Reader" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#2BD99F;strokeWidth=2;fontColor=#2BD99F;labelBackgroundColor=#0A1730;fontFamily=Segoe UI;exitX=1;exitY=0.85;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="portal" target="sa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="540" /><mxPoint x="390" y="565" /><mxPoint x="1077" y="565" /></Array></mxGeometry></mxCell>
        <mxCell id="e-vm" value="SMB 445 + key" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeColor=#FFC04D;strokeWidth=2;fontColor=#FFC04D;labelBackgroundColor=#0A1730;fontFamily=Segoe UI;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="vm" target="sa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
